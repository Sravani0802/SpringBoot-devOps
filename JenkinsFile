pipeline {
    agent any

    environment {
        AWS_REGION = "ap-south-1"
        ECR_REPO = "138383657739.dkr.ecr.ap-south-1.amazonaws.com/springboot-devops-app"
        IMAGE_TAG = "${BUILD_NUMBER}"   // better than latest
    }

    stages {

        stage('Webhook Trigger') {
            steps {
                echo "GitHub webhook triggered successfully!"
            }
        }

        stage('Checkout Code') {
            steps {
                git branch: 'master',
                url: 'https://github.com/Sravani0802/SpringBoot-devOps.git',
                credentialsId: 'github-creds'
            }
        }

        stage('Build Maven') {
            steps {
                bat 'mvn clean package -DskipTests'
            }
        }

        stage('Build Docker Image') {
            steps {
                bat 'docker build -t springboot-app .'
            }
        }

        stage('Login to ECR') {
            steps {
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-cred']]) {
                    bat """
                    aws ecr get-login-password --region %AWS_REGION% | docker login --username AWS --password-stdin %ECR_REPO%
                    """
                }
            }
        }

        stage('Tag Docker Image') {
            steps {
                bat """
                docker tag springboot-app %ECR_REPO%:%IMAGE_TAG%
                """
            }
        }

        stage('Push to ECR') {
            steps {
                bat """
                docker push %ECR_REPO%:%IMAGE_TAG%
                """
            }
        }

        stage('Update K8s Manifest') {
            steps {
                powershell '''
                (Get-Content k8s/spring-boot.yaml) -replace "image: .*", "image: $env:ECR_REPO:$env:IMAGE_TAG" | Set-Content k8s/spring-boot.yaml
                '''
            }
        }

        stage('Commit & Push to GitHub') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'github-creds', usernameVariable: 'GIT_USER', passwordVariable: 'GIT_PASS')]) {
                    bat """
                    git config user.name "ci-cd-bot"
                    git config user.email "ci-cd-bot@Devops.com"
                    git add k8s/spring-boot.yaml
                    git commit -m "Update image to %IMAGE_TAG%" || echo No changes to commit
                    git push https://%GIT_USER%:%GIT_PASS%@github.com/Sravani0802/SpringBoot-devOps.git HEAD:main-master
                    """
                }
            }
        }
    }

    post {
        success {
            echo "Pipeline executed successfully. Argo CD will deploy changes automatically."
        }
        failure {
            echo "Pipeline failed. Check logs."
        }
    }
}